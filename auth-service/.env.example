# Database — MySQL
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT — use a long random string (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_key
JWT_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000   # optional — defaults to 7 days

# Password reset
# FRONTEND_URL=http://localhost:5173  # optional — used in reset email links
