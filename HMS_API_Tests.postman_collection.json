  "item": [
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "1.1 Login as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('ACCESS_TOKEN',  json.data.accessToken);",
                  "pm.collectionVariables.set('REFRESH_TOKEN', json.data.refreshToken);",
                  "pm.collectionVariables.set('AUTH_USER_ID',  json.data.id);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has accessToken',  () => pm.expect(json.data.accessToken).to.be.a('string'));",
                  "pm.test('Has refreshToken', () => pm.expect(json.data.refreshToken).to.be.a('string'));",
                  "pm.test('Role is ADMIN',    () => pm.expect(json.data.role).to.eql('ADMIN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hospital.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/api/v1/auth/login", "host": ["{{BASE_URL}}"], "path": ["api","v1","auth","login"] }
          }
        },
