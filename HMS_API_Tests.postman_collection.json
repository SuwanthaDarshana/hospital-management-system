{
  "info": {
    "name": "Hospital Management System — Full API Tests",
    "_postman_id": "hms-api-collection-v1",
    "description": "Complete API test collection for HMS microservices. All requests go through the API Gateway on port 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL",      "value": "http://localhost:8080" },
